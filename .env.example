# Configuración de conexión a PostgreSQL para la Fase B: Carga

# DATABASE_URL sigue el formato: postgresql+psycopg2://usuario:contraseña@host:puerto/base_de_datos
# Ejemplos:

# Local (PostgreSQL en tu máquina)
# DATABASE_URL=postgresql+psycopg2://postgres:tu_contraseña@localhost:5432/dengue_bodega

# NeonDB (PostgreSQL serverless)
# DATABASE_URL=postgresql+psycopg2://neondb_owner:contraseña@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Supabase (PostgreSQL alojado)
# DATABASE_URL=postgresql+psycopg2://postgres:contraseña@db.xxxxx.supabase.co:5432/postgres

DATABASE_URL=
